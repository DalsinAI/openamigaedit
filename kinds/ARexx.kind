# OpenEdit colour kind: ARexx. MIT, Copyright (c) 2026 Dalsin Limited.
name      ARexx
files     #?.(rexx|rx|ced|ged|amirx|thor|ow|oe)
paths     REXX:#?
firstline /'*#?
case      off
block     /* */
nest      on
strings   "'
labels    colon
numbers   on
keywords  ADDRESS ARG BREAK CALL DO DROP ECHO ELSE END EXIT IF INTERPRET ITERATE LEAVE NOP
keywords  NUMERIC OPTIONS OTHERWISE PARSE PROCEDURE PULL PUSH QUEUE RESULTS RETURN SAY SELECT
keywords  SHELL SIGNAL THEN TO BY FOR FOREVER UNTIL WHILE WHEN WITH UPPER VALUE VAR SOURCE
keywords  EXPOSE FAILAT PROMPT TRACE ON OFF ERROR HALT IOERR SYNTAX BREAK_C RC RESULT SIGL
commands  ABBREV ABS ADDLIB ADDRESS ARG B2C BITAND BITCHG BITCLR BITCOMP BITOR BITSET BITTST
commands  BITXOR C2B C2D C2X CENTER CENTRE CLOSE COMPARE COMPRESS COPIES D2C D2X DATATYPE
commands  DATE DELSTR DELWORD DIGITS EOF ERRORTEXT EXISTS EXPORT FIND FORM FREESPACE FUZZ
commands  GETCLIP GETSPACE HASH IMPORT INDEX INSERT LASTPOS LEFT LENGTH LINES MAX MIN OPEN
commands  OVERLAY POS PRAGMA RANDOM RANDU READCH READLN REMLIB REVERSE RIGHT SEEK SETCLIP
commands  SHOW SIGN SOURCELINE SPACE STORAGE STRIP SUBSTR SUBWORD SYMBOL TIME TRANSLATE TRIM
commands  TRUNC UPPER VERIFY WORD WORDINDEX WORDLENGTH WORDS WRITECH WRITELN X2C X2D
